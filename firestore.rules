rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Unique Tekka player name reservations
    match /tekkaNames/{normalizedName} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Official Game Registry collection
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Tekka Multiplayer Rooms
    match /rooms/{roomId} {
      // Allow reading room metadata for discovery, room code lookups, and lobby sync
      allow read: if isAuthenticated();
      
      // Allow creating room if current user is set as host
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      
      // Allow updating room (joining, leaving, match status changes)
      allow update: if isAuthenticated();
      
      // Allow host to delete/abandon room
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      // Public session state subcollection
      match /publicSession/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Private player views subcollection - STRICT PRIVACY ENFORCEMENT
      // Each player can ONLY read their own private view document!
      match /playerViews/{userId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated();
      }

      // Authoritative secret state subcollection
      match /authoritative/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }
  }
}
