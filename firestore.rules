rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == "jibeshsarkar77@gmail.com")
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Unique Tekka player name reservations
    match /tekkaNames/{normalizedName} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Official Game Registry collection
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tekka Multiplayer Rooms
    match /rooms/{roomId} {
      // Allow reading room metadata for discovery, room code lookups, lobby sync, and admin monitoring
      allow read: if isAuthenticated();
      
      // Allow creating room if current user is set as host
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      
      // Allow updating room (joining, leaving, match status changes)
      allow update: if isAuthenticated();
      
      // Allow host or admin to delete/abandon room
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());

      // Public session state subcollection
      match /publicSession/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Private player views subcollection - STRICT PRIVACY ENFORCEMENT
      // Each player can ONLY read their own private view document!
      // Admin does NOT bypass this to protect secret cards during active games.
      match /playerViews/{userId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated();
      }

      // Authoritative secret state subcollection
      match /authoritative/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Authorized Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      // Admin write is permitted for authorized admins or bootstrapping the designated owner account
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId && request.auth.token.email == "jibeshsarkar77@gmail.com");
    }

    // Live Visitor and Online User Presence Collection
    match /presence/{sessionId} {
      // Any visitor (authenticated or anonymous) can record and update their own presence heartbeat
      allow create, update: if true;
      // Only authorized admins can query all presence records, protecting user privacy
      allow read: if isAdmin();
      // Admins or session creators can delete stale presence
      allow delete: if isAdmin();
    }

    // Admin Audit Logs Collection - STRICT ADMIN ONLY
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit log trail
    }

    // Admin Platform Statistics Aggregates - STRICT ADMIN ONLY
    match /adminStats/{statId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
