{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile with separate account credentials and public Tekka player identity",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Account email address" },
        "googleDisplayName": { "type": "string", "description": "Google account display name (private)" },
        "tekkaName": { "type": "string", "description": "Unique public Tekka gaming handle" },
        "tekkaNameNormalized": { "type": "string", "description": "Lowercase normalized Tekka name for uniqueness verification" },
        "displayName": { "type": "string", "description": "Display name alias for UI components" },
        "avatarUrl": { "type": "string", "description": "Gamer avatar URL" },
        "photoURL": { "type": "string", "description": "Google profile photo URL" },
        "createdAt": { "type": "string", "description": "Account creation date string" },
        "memberTier": { "type": "string", "description": "Gamer membership status tier" },
        "bio": { "type": "string", "description": "Public player bio" },
        "country": { "type": "string", "description": "Player regional location" },
        "wishlistedGameIds": { "type": "array", "description": "List of tracked game IDs" },
        "preferences": { "type": "object", "description": "Player audio and graphic preferences" },
        "stats": { "type": "object", "description": "Tracked stats and leaderboard reputation" }
      },
      "required": ["uid", "email"]
    },
    "tekkaNames": {
      "title": "Tekka Name Reservation",
      "description": "Unique atomic reservations of normalized Tekka player handles",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner Firebase UID" },
        "displayName": { "type": "string", "description": "Case-preserved Tekka player name" },
        "normalized": { "type": "string", "description": "Normalized lowercase key" }
      },
      "required": ["uid", "displayName"]
    },
    "games": {
      "title": "Game Catalog Entry",
      "description": "Official game catalog records and rule constraints",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Canonical game identifier matching document ID" },
        "name": { "type": "string", "description": "Human-readable game title" },
        "slug": { "type": "string", "description": "Unique URL/app-safe identifier" },
        "shortDescription": { "type": "string", "description": "Short summary for game discovery" },
        "description": { "type": "string", "description": "In-depth game description" },
        "thumbnail": { "type": "string", "description": "Card thumbnail artwork URL" },
        "banner": { "type": "string", "description": "Banner artwork URL" },
        "logo": { "type": "string", "description": "Optional game logo URL" },
        "minPlayers": { "type": "number", "description": "Minimum players required by game rules" },
        "maxPlayers": { "type": "number", "description": "Maximum players supported by game rules" },
        "estimatedDurationMinutes": { "type": "number", "description": "Estimated duration in minutes" },
        "estimatedDuration": { "type": "string", "description": "Formatted duration string" },
        "status": { "type": "string", "description": "Game status: available, coming-soon, maintenance, hidden" },
        "featured": { "type": "boolean", "description": "Whether the game is featured on platform" },
        "engineId": { "type": "string", "description": "Optional identifier for future game engine binding" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "slug", "minPlayers", "maxPlayers", "status"]
    },
    "rooms": {
      "title": "Tekka Multiplayer Room",
      "description": "Multiplayer table session containing real authenticated player memberships and room status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Room document ID" },
        "roomCode": { "type": "string", "description": "Unique 6-character room code" },
        "gameId": { "type": "string", "description": "Game identifier" },
        "gameName": { "type": "string", "description": "Game title" },
        "engineId": { "type": "string", "description": "Game engine identifier" },
        "hostId": { "type": "string", "description": "Firebase UID of room creator" },
        "players": { "type": "array", "description": "List of room participant objects" },
        "playerCount": { "type": "number", "description": "Current number of joined players" },
        "minPlayers": { "type": "number", "description": "Minimum player requirement" },
        "maxPlayers": { "type": "number", "description": "Maximum player limit (e.g. 4)" },
        "status": { "type": "string", "enum": ["WAITING", "STARTING", "PLAYING", "FINISHED", "ABANDONED"] },
        "totalRounds": { "type": "number", "enum": [5, 10, 15, 20] },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "roomCode", "gameId", "hostId", "players", "playerCount", "minPlayers", "maxPlayers", "status"]
    },
    "admins": {
      "title": "Admin Record",
      "description": "Authorized Tekka admin account privileges and role bindings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Admin Firebase Auth UID" },
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "description": "Admin role: super_admin, admin, moderator" },
        "createdAt": { "type": "string", "description": "When admin status was granted" },
        "lastLoginAt": { "type": "string", "description": "Last admin portal login timestamp" },
        "grantedBy": { "type": "string", "description": "System or admin UID who granted access" }
      },
      "required": ["uid", "email", "role"]
    },
    "presence": {
      "title": "Live Visitor Presence",
      "description": "Real-time heartbeat presence record for anonymous and authenticated visitors",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique session identifier" },
        "uid": { "type": "string", "description": "Firebase UID if authenticated" },
        "tekkaName": { "type": "string", "description": "Tekka player handle if authenticated" },
        "isAnonymous": { "type": "boolean", "description": "Whether visitor is anonymous" },
        "location": { "type": "string", "enum": ["game-hub", "room-lobby", "in-game", "admin-portal"] },
        "roomId": { "type": "string", "description": "Active room ID if inside a room" },
        "gameId": { "type": "string", "description": "Active game ID if viewing or playing a game" },
        "lastHeartbeat": { "type": "number", "description": "Epoch timestamp of last heartbeat" },
        "createdAt": { "type": "string", "description": "When session started" }
      },
      "required": ["sessionId", "isAnonymous", "location", "lastHeartbeat"]
    },
    "adminAuditLogs": {
      "title": "Admin Audit Log",
      "description": "Immutable security log of all administrative actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Audit log document ID" },
        "adminUid": { "type": "string", "description": "UID of acting admin" },
        "adminEmail": { "type": "string", "description": "Email of acting admin" },
        "action": { "type": "string", "description": "Admin action code" },
        "targetType": { "type": "string", "description": "Target entity type" },
        "targetId": { "type": "string", "description": "Target document or entity ID" },
        "targetName": { "type": "string", "description": "Target descriptive name" },
        "timestamp": { "type": "number", "description": "Epoch timestamp of action" },
        "result": { "type": "string", "enum": ["SUCCESS", "FAILURE"] },
        "details": { "type": "object", "description": "Contextual details and parameters" }
      },
      "required": ["id", "adminUid", "action", "timestamp", "result"]
    },
    "adminStats": {
      "title": "Admin Statistics Snapshot",
      "description": "Pre-computed or cached operational metrics and statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Statistics document key" },
        "updatedAt": { "type": "number", "description": "Epoch timestamp of last update" },
        "metrics": { "type": "object", "description": "Aggregated metrics map" }
      },
      "required": ["id", "updatedAt", "metrics"]
    },
    "gameMatches": {
      "title": "Authoritative Game Match",
      "description": "Completed and active multiplayer game match telemetry and standings",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Room ID identifier matching document ID" },
        "gameId": { "type": "string", "description": "Game ID (e.g. chor-police-dakat-babu or chakranto)" },
        "gameName": { "type": "string", "description": "Display name of the game" },
        "status": { "type": "string", "enum": ["PLAYING", "FINISHED", "ABANDONED"] },
        "playerIds": { "type": "array", "description": "List of participant UIDs" },
        "playerNames": { "type": "array", "description": "List of participant handles" },
        "startedAt": { "type": "string", "description": "ISO timestamp when match started" },
        "completedAt": { "type": "string", "description": "ISO timestamp when match concluded" },
        "durationSeconds": { "type": "number", "description": "Total match duration in seconds" },
        "winnerIds": { "type": "array", "description": "UIDs of winning player(s)" },
        "winnerNames": { "type": "array", "description": "Handles of winning player(s)" },
        "totalRounds": { "type": "number", "description": "Configured round count if applicable" },
        "roundsPlayed": { "type": "number", "description": "Actual rounds completed" }
      },
      "required": ["roomId", "gameId", "status", "playerIds", "startedAt"]
    },
    "uniqueVisitors": {
      "title": "Daily Unique Visitor Entry",
      "description": "Deduplicated daily visitor records for attendance telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Composite key {visitorId}_{dateStr}" },
        "visitorId": { "type": "string", "description": "Unique device visitor ID" },
        "date": { "type": "string", "description": "YYYY-MM-DD date in Asia/Kolkata timezone" },
        "firstSeen": { "type": "number", "description": "Epoch timestamp of first daily appearance" },
        "lastSeen": { "type": "number", "description": "Epoch timestamp of last daily activity" },
        "isAnonymous": { "type": "boolean", "description": "Whether visitor was unauthenticated" }
      },
      "required": ["id", "visitorId", "date", "firstSeen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/tekkaNames/{normalizedName}": {
      "schema": "tekkaNames",
      "description": "Unique reservation entries for player handles"
    },
    "/games/{gameId}": {
      "schema": "games",
      "description": "Official game catalog records"
    },
    "/rooms/{roomId}": {
      "schema": "rooms",
      "description": "Multiplayer match rooms"
    },
    "/rooms/{roomId}/publicSession/{docId}": {
      "schema": "rooms",
      "description": "Chor Police public game session state"
    },
    "/rooms/{roomId}/playerViews/{userId}": {
      "schema": "rooms",
      "description": "Chor Police private player hand view"
    },
    "/rooms/{roomId}/authoritative/{docId}": {
      "schema": "rooms",
      "description": "Chor Police authoritative secret state"
    },
    "/rooms/{roomId}/chakrantoPublic/{docId}": {
      "schema": "rooms",
      "description": "Chakranto public game session state"
    },
    "/rooms/{roomId}/chakrantoViews/{userId}": {
      "schema": "rooms",
      "description": "Chakranto private player hand view"
    },
    "/rooms/{roomId}/chakrantoAuthoritative/{docId}": {
      "schema": "rooms",
      "description": "Chakranto authoritative secret state"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Authorized admin users registry"
    },
    "/presence/{sessionId}": {
      "schema": "presence",
      "description": "Live visitor and user heartbeat presence"
    },
    "/uniqueVisitors/{visitorDocId}": {
      "schema": "uniqueVisitors",
      "description": "Daily unique visitor attendance tracking"
    },
    "/gameMatches/{matchId}": {
      "schema": "gameMatches",
      "description": "Authoritative match outcomes and telemetry"
    },
    "/adminAuditLogs/{logId}": {
      "schema": "adminAuditLogs",
      "description": "Admin activity audit log trail"
    },
    "/adminStats/{statId}": {
      "schema": "adminStats",
      "description": "Aggregated platform statistics snapshots"
    }
  }
}
